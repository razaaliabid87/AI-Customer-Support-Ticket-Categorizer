        "messages": {
          "messageValues": [
            {
              "message": "=You are a senior customer support manager.\n\nAnalyze this ticket.\n\nDetermine:\n\n1. Category\n\nChoose ONE:\n\nTechnical Issue\nBilling\nSales Inquiry\nFeature Request\nBug Report\nGeneral Question\nComplaint\n\n2. Priority\n\nChoose ONE:\n\nCritical\nHigh\nMedium\nLow\n\n3. Sentiment\n\nChoose ONE:\n\nPositive\nNeutral\nNegative\n\n4. Assigned Team\nChoose ONE:\nTechnical Support (if category is: Technical issue OR Bug Report)\nBilling Team (if category is: Billing)\nSales Team (if category is: Sales Inquiry)\nCustomer Success (if category is: Feature Request OR Complaint)\nGeneral Support (if category is: General Question)\n\n5. Summary\n\nReturn ONLY valid JSON.\n\n{\n\"category\":\"\",\n\"priority\":\"\",\n\"sentiment\":\"\",\n\"assigned_team\":\"\",\n\"summary\":\"\"\n}\n"
            }
          ]
        },
        "batching": {}
      },
