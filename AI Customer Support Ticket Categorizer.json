    {
      "parameters": {
        "jsCode": "function toTitleCase(text) {\n  return text\n    .toLowerCase()\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .replace(/\\b\\w/g, c => c.toUpperCase());\n}\n\nreturn [\n  {\n    json: {\n      name: toTitleCase($json.name),\n      email: $json.email.trim().toLowerCase(),\n      subject: toTitleCase($json.subject),\n      message: $json.message.replace(/\\s+/g, ' ').trim()\n    }\n  }\n];"
      },
